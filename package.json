{
  "name": "animedy",
  "version": "1.0.0",
  "description": "Animedy - Continuous Anime Watching Platform",
  "type": "module",
  "main": "src/animedy_v1/index.ts",
  "scripts": {
    "setup": "bash ./setup.sh",
    "install:all": "npm install && (cd src/ui_test && npm install)",
    "dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/animedy_v1/index.ts",
    "build": "npx tsc -p tsconfig.json && (cd src/ui_test && npm install && npm run build)",
    "postbuild": "mkdir -p dist/jsondef && cp -R src/jsondef/. dist/jsondef/",
    "start": "node --env-file-if-exists=.env dist/animedy_v1/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "node node_modules/eslint/bin/eslint.js src"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.18.1"
  }
}
