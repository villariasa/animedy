{
  "openapi": "3.0.3",
  "info": { "title": "Animedy API", "version": "1.0.0" },
  "paths": {
    "/api/episodes/sources": {
      "post": {
        "summary": "Stream URL, qualities, and subtitles for an episode",
        "tags": ["Episodes"],
        "security": [{ "bearerAuth": [] }],
        "description": "Bearer token optional (guest-ok).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["episode_id"],
                "additionalProperties": false,
                "properties": { "episode_id": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Episode sources retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "http_code": { "type": "integer" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "episode_id": { "type": "integer" },
                        "stream_url": { "type": "string" },
                        "subtitles": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "lang": { "type": "string" },
                              "label": { "type": "string" },
                              "url": { "type": "string" }
                            }
                          }
                        },
                        "qualities": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": { "type": "string" },
                              "url": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Episode not found" },
          "422": { "description": "Validation failure" }
        }
      }
    }
  }
}
