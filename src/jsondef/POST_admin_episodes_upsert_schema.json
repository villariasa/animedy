{
  "openapi": "3.0.3",
  "info": { "title": "Animedy API", "version": "1.0.0" },
  "paths": {
    "/api/admin/episodes/upsert": {
      "post": {
        "summary": "Attach self-hosted stream URLs/subtitles/qualities to episodes (bulk upsert)",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "description": "Requires role='admin' JWT claim.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["episodes"],
                "additionalProperties": false,
                "properties": {
                  "episodes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "required": ["anime_id", "episode_number", "stream_url"],
                      "additionalProperties": false,
                      "properties": {
                        "anime_id": { "type": "integer", "minimum": 1 },
                        "episode_number": { "type": "integer", "minimum": 1 },
                        "title": { "type": "string", "maxLength": 512 },
                        "duration_seconds": { "type": "integer", "minimum": 1 },
                        "air_date": { "type": "string", "format": "date" },
                        "thumbnail": { "type": "string", "format": "uri" },
                        "stream_url": { "type": "string", "format": "uri" },
                        "subtitles": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["lang", "label", "url"],
                            "additionalProperties": false,
                            "properties": {
                              "lang": { "type": "string" },
                              "label": { "type": "string" },
                              "url": { "type": "string", "format": "uri" }
                            }
                          }
                        },
                        "qualities": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["label", "url"],
                            "additionalProperties": false,
                            "properties": {
                              "label": { "type": "string" },
                              "url": { "type": "string", "format": "uri" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Episodes upserted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "http_code": { "type": "integer" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "episode_ids": { "type": "array", "items": { "type": "integer" } }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Missing or invalid token" },
          "403": { "description": "Admin role required" },
          "422": { "description": "Validation failure" }
        }
      }
    }
  }
}
